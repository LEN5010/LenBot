# Build context contains only release source, the frontend the image builds
# itself, and the fixed worker recipes.
**
!pyproject.toml
!uv.lock
!README.md
!src/
!src/len_bot/
!src/len_bot/**
src/len_bot/**/__pycache__/
src/len_bot/**/*.pyc
# The frontend sources stay in the context so the Node stage can build the
# panel, but its installed toolchain and any local build output never do:
# the image installs from package-lock.json and builds fresh.
src/len_bot/web/frontend/node_modules/
src/len_bot/web/static/dist/
!containers/
!containers/**
!deploy/
!deploy/linux/
!deploy/linux/Dockerfile
