# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# The bare `dist/` rule above would also swallow the built control plane, which
# FastAPI serves and which ships with the same batch of API changes.  These
# un-ignores keep that one path committable while a same-named directory
# somewhere new still stays out (git ignores a file inside an ignored
# directory, so every level of the path has to be un-ignored, not just the
# leaf).  They must stay below the rule they counter; gitignore order decides.
!src/len_bot/
!src/len_bot/web/
!src/len_bot/web/static/
!src/len_bot/web/static/dist/**

# Virtual Environment
.venv/
env/
venv/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Databases
*.db
*.db-journal
*.db-wal
*.db-shm
/media/

# IDE / OS
.DS_Store
.vscode/
.idea/

# Node / frontend tooling
node_modules/
.vite/

# ZCode session artifacts
.zcode/

# Exception: the built control plane is served by FastAPI and versioned
!src/len_bot/web/static/dist/

# Local trial state and recovery copies
/.backups/
/.runtime/
/lenbot.config.json
/.lenbot-config-*.json
/gateway.config.json
