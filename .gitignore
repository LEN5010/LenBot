wheels/
*.egg-info/
.installed.cfg
*.egg

# The built control plane stays out of Git.  Vite content-hashes every asset,
# so committing it turned each frontend change into a delete+add churn of ~40
# files that buried the real diff.  It is produced by `npm run build` for local
# runs and by the Node stage in deploy/current/Dockerfile for deploys; the bare
# `dist/` rule above already covers it, and this anchored rule records intent.
/src/len_bot/web/static/dist/

# Virtual Environment
.venv/
env/
venv/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Databases
*.db
*.db-journal
*.db-wal
*.db-shm
/media/

# IDE / OS
.DS_Store
.vscode/
.idea/

# Node / frontend tooling
node_modules/
.vite/

# Frontend source helpers are not Python installation output.
!/src/len_bot/web/frontend/src/lib/

# ZCode session artifacts
.zcode/

# Local trial state and recovery copies
.lenbot-instance.lock
/.backups/
/.runtime/
/lenbot.config.json
/.lenbot-config-*.json
/.lenbot-setup-*.json
/gateway.config.json

# 设计文档与工作记录只留在本机
/docs/

# Local business state, personal role packages and evaluation runs
/state/
/plugins/
/plugin-installations/
/.plugin-candidates/
/plugin-data/
/personas/
/data/eval/runs/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.sqlite3.v*.bak

# Local task deliveries shared read-only with OneBot
/file_assets/

# Public replay example: local configuration and results
/examples/replay/lenbot.config.json
/examples/replay/chat.sqlite3*
/examples/replay/runs/
