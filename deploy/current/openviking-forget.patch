+        )
+        result = [{**entry, "uri": self._tree_path_to_uri(entry["path"])} for entry in entries]
+        await self._ensure_access_many([entry["uri"] for entry in result], ctx, action=AclAction.WRITE)
+        return result
+
+    async def forget_snapshot_paths(self, paths: List[str], replacements: List[tuple[str, str, bytes]],
+                                    *, ctx: RequestContext) -> Dict[str, Any]:
+        """Erase selected paths from stored snapshots, not merely from the next commit."""
+        await self._ensure_access_many(paths, ctx, action=AclAction.WRITE)
+        return await self._async_agfs.run(
+            "git_forget", account=ctx.account_id,
+            paths=[self._uri_to_tree_path(path, ctx=ctx) for path in paths],
+            replacements=[(self._uri_to_tree_path(path, ctx=ctx), oid, content)
+                          for path, oid, content in replacements],
+        )
