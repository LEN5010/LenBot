+//! Remove selected paths from every stored snapshot, including detached history.
+
+use std::collections::{HashMap, HashSet};
+
+use gix_hash::ObjectId;
+use gix_object::Kind;
+
+use super::error::GitError;
+use super::index_store::CommitIndex;
+use super::service::GitService;
+use super::tree_builder::{flatten, lookup, TreeEditor};
+use super::util::{parse_object_header, read_object, write_object};
+
+#[derive(Debug)]
+pub struct ForgetResponse {
+    pub commits_rewritten: usize,
+    pub refs_updated: usize,
+    pub objects_removed: usize,
+}
+
+pub struct HistoricalFile {
+    pub path: String,
+    pub oid: ObjectId,
+    pub content: Vec<u8>,
+}
+
+pub(super) async fn history_files(service: &GitService, account: &str, prefix: &str,
+                                 names: &[String]) -> Result<Vec<HistoricalFile>, GitError> {
+    let store = service.object_store.as_ref();
+    let mut roots = HashSet::new();
+    for oid in store.list(account).await? {
+        let raw = read_object(store, account, &oid).await?;
+        let (kind, _, header) = parse_object_header(&raw)?;
+        if kind == Kind::Commit {
+            let commit = gix_object::CommitRef::from_bytes(&raw[header..])
+                .map_err(|error| GitError::Other(format!("commit {oid}: {error}")))?;
+            roots.insert(commit.tree());
+        }
+    }
+    let mut entries = HashSet::new();
+    for root in roots {
+        for (path, oid) in flatten(store, account, root, &Some(vec![format!("{prefix}/")])).await? {
+            if names.iter().any(|name| path.ends_with(&format!("/{name}"))) {
+                entries.insert((path, oid));
+            }
+        }
+    }
+    let mut result = Vec::new();
+    for (path, oid) in entries {
+        let raw = read_object(store, account, &oid).await?;
+        let (kind, _, header) = parse_object_header(&raw)?;
+        if kind != Kind::Blob {
+            return Err(GitError::Other(format!("snapshot file {path} is {kind:?}")));
+        }
+        result.push(HistoricalFile {path, oid, content: raw[header..].to_vec()});
+    }
+    Ok(result)
+}
+
+struct Commit {
+    body: Vec<u8>,
+    tree: ObjectId,
+    parents: Vec<ObjectId>,
+}
+
+/// The caller holds the account's snapshot-write lock for this entire operation.
+pub(super) async fn forget_paths(
+    service: &GitService,
+    account: &str,
+    paths: &[String],
+    replacements: &HashMap<(String, ObjectId), Vec<u8>>,
+) -> Result<ForgetResponse, GitError> {
+    let store = service.object_store.as_ref();
+    let original_objects = store.list(account).await?;
+    let refs = service.ref_store.list(account, "refs").await?;
+    let mut commits = HashMap::new();
+    for oid in &original_objects {
+        let raw = read_object(store, account, oid).await?;
+        let (kind, _, header) = parse_object_header(&raw)?;
+        match kind {
+            Kind::Commit => {
+                let parsed = gix_object::CommitRef::from_bytes(&raw[header..])
+                    .map_err(|error| GitError::Other(format!("commit {oid}: {error}")))?;
+                commits.insert(*oid, Commit {
+                    body: raw[header..].to_vec(),
+                    tree: parsed.tree(),
+                    parents: parsed.parents().collect(),
+                });
+            }
+            Kind::Blob | Kind::Tree => {}
+            Kind::Tag => return Err(GitError::Other(
+                "snapshot forgetting does not support annotated tag objects".into())),
+        }
+    }
+
+    let mut rewritten = HashMap::new();
+    let mut trees = HashMap::new();
+    let mut pending: HashSet<ObjectId> = commits.keys().copied().collect();
+    while !pending.is_empty() {
+        let ready: Vec<ObjectId> = pending.iter().copied().filter(|oid|
+            commits[oid].parents.iter().all(|parent| rewritten.contains_key(parent))
+        ).collect();
+        if ready.is_empty() {
+            return Err(GitError::Other(format!(
+                "snapshot history has missing or cyclic parents: {pending:?}")));
+        }
+        for oid in ready {
+            let old = &commits[&oid];
+            let tree = if let Some(tree) = trees.get(&old.tree) {
+                *tree
+            } else {
+                let mut editor = TreeEditor::from_tree(store, account, old.tree).await?;
+                for path in paths {
+                    editor.remove(store, account, path).await?;
+                }
+                for ((path, old_blob), content) in replacements {
+                    if let Some((blob, _)) = lookup(store, account, old.tree, path).await? {
+                        if blob == *old_blob {
+                            let new_blob = write_object(store, account, Kind::Blob, content).await?;
+                            editor.upsert(store, account, path, new_blob).await?;
+                        }
+                    }
+                }
+                let tree = editor.write(store, account).await?;
+                trees.insert(old.tree, tree);
+                tree
+            };
+            let parents: Vec<ObjectId> = old.parents.iter().map(|parent| rewritten[parent]).collect();
+            let new_oid = if tree == old.tree && parents == old.parents {
+                oid
+            } else {
+                let body = rewrite_commit(&old.body, tree, &parents)?;
+                write_object(store, account, Kind::Commit, &body).await?
+            };
+            rewritten.insert(oid, new_oid);
+            pending.remove(&oid);
+        }
+    }
+
+    // Retain unrelated detached snapshots as well as history named by refs.
+    // A blob shared by another surviving path still belongs to that path.
+    let mut retained = HashSet::new();
+    let mut stack: Vec<ObjectId> = rewritten.values().copied().collect();
+    while let Some(oid) = stack.pop() {
+        if !retained.insert(oid) || oid == ObjectId::empty_tree(gix_hash::Kind::Sha1) {
+            continue;
+        }
+        let raw = read_object(store, account, &oid).await?;
+        let (kind, _, header) = parse_object_header(&raw)?;
+        match kind {
+            Kind::Commit => {
+                let commit = gix_object::CommitRef::from_bytes(&raw[header..])
+                    .map_err(|error| GitError::Other(format!("commit {oid}: {error}")))?;
+                stack.push(commit.tree());
+                stack.extend(commit.parents());
+            }
+            Kind::Tree => {
+                let tree = gix_object::TreeRef::from_bytes(&raw[header..])
+                    .map_err(|error| GitError::Other(format!("tree {oid}: {error}")))?;
+                stack.extend(tree.entries.iter().filter(|entry|
+                    entry.mode.kind() != gix_object::tree::EntryKind::Commit
+                ).map(|entry| entry.oid.to_owned()));
+            }
+            Kind::Blob => {}
+            Kind::Tag => unreachable!("annotated tags rejected before snapshot mutation"),
+        }
+    }
+
+    let mut refs_updated = 0;
+    for (name, old) in &refs {
+        let new = rewritten.get(old).ok_or_else(||
+            GitError::Other(format!("snapshot ref {name} does not name a stored commit: {old}")))?;
+        if new != old {
+            service.ref_store.cas_update(account, name, Some(*old), *new).await?;
+            refs_updated += 1;
+        }
+        if let (Some(index), Some(branch)) = (&service.index_store, name.strip_prefix("refs/heads/")) {
+            index.save(account, branch, &CommitIndex {
+                parent_oid: *new, entries: HashMap::new(), saved_at_ns: None,
+            }).await.map_err(|error| GitError::Other(format!("clear snapshot index: {error}")))?;
+        }
+    }
+    let mut objects_removed = 0;
+    for oid in original_objects {
+        if !retained.contains(&oid) {
+            store.remove(account, &oid).await?;
+            objects_removed += 1;
+        }
+    }
+    Ok(ForgetResponse {
+        commits_rewritten: rewritten.iter().filter(|(old, new)| old != new).count(),
+        refs_updated,
+        objects_removed,
+    })
+}
+
+fn rewrite_commit(body: &[u8], tree: ObjectId, parents: &[ObjectId]) -> Result<Vec<u8>, GitError> {
+    let header_end = body.windows(2).position(|bytes| bytes == b"\n\n")
+        .ok_or_else(|| GitError::Other("commit has no header boundary".into()))?;
+    let mut result = format!("tree {}\n", tree.to_hex()).into_bytes();
+    for parent in parents {
+        result.extend_from_slice(format!("parent {}\n", parent.to_hex()).as_bytes());
+    }
+    for line in body[..header_end].split(|byte| *byte == b'\n') {
+        if !line.starts_with(b"tree ") && !line.starts_with(b"parent ") {
+            result.extend_from_slice(line);
+            result.push(b'\n');
+        }
+    }
+    result.extend_from_slice(&body[header_end + 1..]);
+    Ok(result)
+}
