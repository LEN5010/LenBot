new file mode 100644
index 0000000..166e2b6
--- /dev/null
+++ b/openviking/service/memory_forget.py
@@ -0,0 +1,192 @@
+"""Path-scoped forgetting of native memory and its stored derivatives."""
+
+from __future__ import annotations
+
+from typing import TypeVar
+
+from pydantic import BaseModel, ConfigDict, ValidationError
+
+from openviking.core.namespace import classify_uri, resolve_uri
+from openviking.server.identity import RequestContext
+from openviking.service.task_tracker import TaskStatus, get_task_tracker
+from openviking.storage.acl import AclAction
+from openviking.storage.errors import ResourceBusyError
+from openviking.storage.viking_fs import VikingFS
+from openviking_cli.exceptions import InvalidArgumentError, OpenVikingError, PermissionDeniedError
+
+
+class ArchiveMessage(BaseModel):
+    model_config = ConfigDict(strict=True, extra="allow")
+    id: str
+    source_message_ids: list[str] | None = None
+
+
+class DiffEntry(BaseModel):
+    model_config = ConfigDict(strict=True, extra="allow")
+    uri: str
+
+
+class SkippedEntry(BaseModel):
+    model_config = ConfigDict(strict=True, extra="allow")
+    uri: str | None = None
+
+
+class DiffOperations(BaseModel):
+    model_config = ConfigDict(strict=True, extra="forbid")
+    adds: list[DiffEntry]
+    updates: list[DiffEntry]
+    deletes: list[DiffEntry]
+
+
+class MemoryDiff(BaseModel):
+    model_config = ConfigDict(strict=True, extra="allow")
+    archive_uri: str
+    operations: DiffOperations
+    skipped_operations: list[SkippedEntry]
+    summary: dict[str, int]
+
+
+Model = TypeVar("Model", bound=BaseModel)
+
+
+def _decode(model: type[Model], raw: str, uri: str) -> Model:
+    try:
+        return model.model_validate_json(raw)
+    except ValidationError as error:
+        raise InvalidArgumentError(f"Cannot read forgetting source {uri}: {error}; raw={raw[:500]!r}") from error
+
+
+def _rewrite_archive(raw: str, path: str, uri: str, sources: set[str]) -> tuple[str | None, set[str]]:
+    matched = set()
+    if path.endswith("/memory_diff.json"):
+        diff = _decode(MemoryDiff, raw, path)
+        changed = False
+        for name in ("adds", "updates", "deletes"):
+            old = getattr(diff.operations, name)
+            kept = [entry for entry in old if entry.uri != uri]
+            changed |= len(kept) != len(old)
+            setattr(diff.operations, name, kept)
+            diff.summary["total_" + name] = len(kept)
+        kept_skips = [entry for entry in diff.skipped_operations if entry.uri != uri]
+        changed |= len(kept_skips) != len(diff.skipped_operations)
+        diff.skipped_operations = kept_skips
+        diff.summary["total_skipped"] = len(kept_skips)
+        if changed:
+            return diff.model_dump_json(indent=2, exclude_unset=True) + "\n", matched
+    elif sources and path.endswith("/messages.jsonl"):
+        kept_lines = []
+        for line in raw.splitlines():
+            message = _decode(ArchiveMessage, line, path)
+            selected = (set() if message.source_message_ids is None
+                        else sources.intersection(message.source_message_ids))
+            if selected:
+                matched.update(selected)
+            else:
+                kept_lines.append(line)
+        if matched:
+            return "".join(line + "\n" for line in kept_lines), matched
+    return None, matched
+
+
+def _parents(uri: str, user_root: str) -> list[str]:
+    result = []
+    parent = uri.rsplit("/", 1)[0]
+    while parent.startswith(user_root):
+        result.append(parent)
+        if parent == user_root:
+            break
+        parent = parent.rsplit("/", 1)[0]
+    return result
+
+
+async def forget_memory(vfs: VikingFS, uri: str, source_message_ids: list[str],
+                        ctx: RequestContext) -> dict:
+    target = resolve_uri(uri)
+    if target.scope != "user" or target.owner_user_id != ctx.user.user_id:
+        raise PermissionDeniedError("Memory forgetting is limited to the calling user's namespace", resource=uri)
+    if (not classify_uri(uri).is_memory or not uri.endswith(".md")
+            or uri.rsplit("/", 1)[-1].startswith(".")):
+        raise InvalidArgumentError("forget requires one explicit memory Markdown file")
+    await vfs._ensure_access(uri, ctx, action=AclAction.WRITE)
+
+    user_root = f"viking://user/{ctx.user.user_id}"
+    session_root = user_root + "/sessions"
+    lease = await vfs._async_agfs.pathlock_acquire_tree(vfs._uri_to_path(user_root, ctx=ctx))
+    completed: dict = {"uri": uri, "rewritten_archives": [], "cleared_uris": []}
+    try:
+        tasks = await get_task_tracker().list_tasks(
+            account_id=ctx.account_id, user_id=ctx.user.user_id, limit=None)
+        active = [task.task_id for task in tasks if task.status in {
+            TaskStatus.PENDING, TaskStatus.RUNNING, TaskStatus.CANCELLING}]
+        if active:
+            raise ResourceBusyError(f"User tasks are still active: {active}", uri=uri)
+
+        entries = await vfs.tree(session_root, output="original", show_all_hidden=True,
+                                 node_limit=None, level_limit=None, ctx=ctx)
+        files = {item["uri"] for item in entries if not item["isDir"]}
+        sources = set(source_message_ids)
+        matched_sources: set[str] = set()
+        writes: dict[str, str] = {}
+        affected_sessions: set[str] = set()
+
+        def affect(path: str) -> None:
+            session_id = path[len(session_root) + 1:].split("/", 1)[0]
+            affected_sessions.add(session_root + "/" + session_id)
+
+        for path in sorted(files):
+            if path.endswith("/memory_diff.json") or (sources and path.endswith("/messages.jsonl")):
+                raw = await vfs.read_file(path, ctx=ctx)
+                content, matched = _rewrite_archive(raw, path, uri, sources)
+                matched_sources.update(matched)
+                if content is not None:
+                    writes[path] = content
+                    affect(path)
+
+        try:
+            for path, content in writes.items():
+                await vfs.write_file(path, content, ctx=ctx, lease_ref=lease)
+                completed["rewritten_archives"].append(path)
+            # Enumerate after source copies are scrubbed: a new snapshot can now
+            # only capture clean current archives. Older versions are edited too,
+            # even if their archive file no longer exists in the working tree.
+            historical = await vfs.snapshot_files_for_forgetting(session_root, ctx=ctx)
+            replacements = []
+            archived_paths = set(writes)
+            for entry in historical:
+                path = entry["uri"]
+                content, matched = _rewrite_archive(entry["content"].decode("utf-8"), path, uri, sources)
+                matched_sources.update(matched)
+                if content is not None:
+                    replacements.append((path, entry["oid"], content.encode("utf-8")))
+                    archived_paths.add(path)
+                    affect(path)
+            parents = set(_parents(uri, user_root))
+            for path in archived_paths:
+                parents.update(_parents(path, user_root))
+            summary_candidates = files | {entry["uri"] for entry in historical}
+            # Later archive overviews can incorporate earlier archives in this session.
+            summaries = {path for path in summary_candidates
+                         if path.endswith(("/.abstract.md", "/.overview.md"))
+                         and any(path.startswith(session + "/") for session in affected_sessions)}
+            parents.update(path.rsplit("/", 1)[0] for path in summaries)
+            summaries.update(parent + "/" + name for parent in parents
+                             for name in (".abstract.md", ".overview.md"))
+            history_paths = sorted({uri, *summaries})
+            await vfs._ensure_access_many(history_paths + list(archived_paths), ctx, action=AclAction.WRITE)
+            # Directory vectors contain abstracts/overviews, not sibling file vectors.
+            await vfs._delete_from_vector_store(sorted(parents), ctx=ctx)
+            for path in [uri, *sorted(summaries)]:
+                await vfs.rm(path, ctx=ctx, lease_ref=lease)
+                completed["cleared_uris"].append(path)
+            completed["snapshots"] = await vfs.forget_snapshot_paths(history_paths, replacements, ctx=ctx)
+        except Exception as error:
+            raise OpenVikingError(
+                f"Memory forgetting stopped: {type(error).__name__}: {error}",
+                code="FORGET_PARTIAL", details=completed,
+            ) from error
+        return {**completed, "source_message_ids": sorted(sources),
+                "matched_source_message_ids": sorted(matched_sources),
+                "notice": "Only selected memory and source copies are removed; other explicit memories, "
+                          "caller chat logs, model requests and external backups are unchanged."}
+    finally:
+        await vfs._async_agfs.pathlock_release(lease)
