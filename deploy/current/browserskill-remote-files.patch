@@ -0,0 +1,69 @@
+mod files;
+mod install;
+
+use anyhow::{Context, Result, ensure};
+use bsk_protocol::BrowserFileParams;
+use serde::Deserialize;
+use serde_json::json;
+use std::io::{self, BufRead, Read, Write};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    id: String,
+    params: BrowserFileParams,
+}
+
+fn serve(files: &mut files::Files) -> Result<()> {
+    let mut input = io::BufReader::new(io::stdin().lock());
+    let mut output = io::stdout().lock();
+    while !input.fill_buf()?.is_empty() {
+        let mut header = [0; 4];
+        input.read_exact(&mut header)?;
+        let length = u32::from_ne_bytes(header) as usize;
+        ensure!(
+            length > 0 && length <= 1024 * 1024,
+            "invalid Native Messaging length: {length}"
+        );
+        let mut raw = vec![0; length];
+        input.read_exact(&mut raw)?;
+        let request: Request = serde_json::from_slice(&raw).with_context(|| {
+            format!(
+                "invalid Native Messaging request: {}",
+                String::from_utf8_lossy(&raw[..raw.len().min(300)])
+            )
+        })?;
+        let reply = match files.execute(request.params) {
+            Ok(result) => json!({"id":request.id,"result":result}),
+            Err(error) => {
+                json!({"id":request.id,"error":{"code":"protocol_error","message":format!("{error:#}")}})
+            }
+        };
+        let bytes = serde_json::to_vec(&reply)?;
+        output.write_all(&(bytes.len() as u32).to_ne_bytes())?;
+        output.write_all(&bytes)?;
+        output.flush()?;
+    }
+    Ok(())
+}
+
+fn main() -> Result<()> {
+    let argument = std::env::args().nth(1);
+    if argument.as_deref() == Some("install") {
+        return install::run();
+    }
+    if matches!(argument.as_deref(), Some("--help" | "-h")) {
+        println!(
+            "bsk-file-host install --extension-id <id> [--manifest-directory <directory>]\nWithout a subcommand, serve Native Messaging on stdin/stdout."
+        );
+        return Ok(());
+    }
+    let mut files = files::Files::new()?;
+    let result = serve(&mut files);
+    let cleanup = files.close();
+    if let Err(error) = &cleanup {
+        eprintln!("{error:#}");
+    }
+    result?;
+    cleanup
+}
