@@ -0,0 +1,275 @@
+use std::collections::HashMap;
+use std::fs::{self, File, OpenOptions};
+use std::io::{Read, Seek, SeekFrom, Write};
+use std::path::{Path, PathBuf};
+
+use anyhow::{Context, Result, bail, ensure};
+use base64::{Engine, engine::general_purpose::STANDARD};
+use bsk_protocol::{BrowserFileCommand, BrowserFileParams};
+use serde_json::{Value, json};
+use tempfile::TempDir;
+use uuid::Uuid;
+
+pub const CHUNK_BYTES: usize = 512 * 1024;
+const MAX_BYTES: u64 = 512 * 1024 * 1024;
+
+struct Entry {
+    session: String,
+    path: PathBuf,
+    size: u64,
+    written: u64,
+    ready: bool,
+    download: bool,
+}
+
+pub struct Files {
+    root: TempDir,
+    entries: HashMap<String, Entry>,
+}
+
+impl Files {
+    pub fn new() -> Result<Self> {
+        Ok(Self {
+            root: tempfile::Builder::new()
+                .prefix("bsk-browser-files-")
+                .tempdir()?,
+            entries: HashMap::new(),
+        })
+    }
+
+    fn entry(&mut self, session: &str, id: &str) -> Result<&mut Entry> {
+        let entry = self
+            .entries
+            .get_mut(id)
+            .context("native file transfer not found")?;
+        ensure!(
+            entry.session == session,
+            "native file transfer belongs to another session"
+        );
+        Ok(entry)
+    }
+
+    pub fn execute(&mut self, params: BrowserFileParams) -> Result<Value> {
+        let session = params.session_id;
+        ensure!(!session.is_empty(), "session_id must not be empty");
+        match params.command {
+            BrowserFileCommand::Ready => Ok(json!({"chunk_size":CHUNK_BYTES})),
+            BrowserFileCommand::Begin { name, byte_size } => {
+                ensure!(
+                    !name.is_empty()
+                        && name != "."
+                        && name != ".."
+                        && !name.contains(['/', '\\', '\0', '\r', '\n']),
+                    "invalid upload filename: {name:?}"
+                );
+                let staged: u64 = self
+                    .entries
+                    .values()
+                    .filter(|e| e.session == session)
+                    .map(|e| e.size)
+                    .sum();
+                ensure!(
+                    byte_size <= MAX_BYTES && staged.saturating_add(byte_size) <= MAX_BYTES,
+                    "session staging exceeds {MAX_BYTES} bytes"
+                );
+                let id = format!("tr_{}", Uuid::new_v4().simple());
+                let directory = self.root.path().join(&id);
+                fs::create_dir(&directory)?;
+                let path = directory.join(&name);
+                OpenOptions::new()
+                    .write(true)
+                    .create_new(true)
+                    .open(&path)?;
+                self.entries.insert(
+                    id.clone(),
+                    Entry {
+                        session,
+                        path,
+                        size: byte_size,
+                        written: 0,
+                        ready: false,
+                        download: false,
+                    },
+                );
+                Ok(json!({"transfer_id":id,"chunk_size":CHUNK_BYTES}))
+            }
+            BrowserFileCommand::Chunk {
+                transfer_id,
+                offset,
+                data_base64,
+            } => {
+                let data = STANDARD
+                    .decode(data_base64)
+                    .context("invalid base64 file chunk")?;
+                ensure!(
+                    data.len() <= CHUNK_BYTES,
+                    "file chunk exceeds {CHUNK_BYTES} bytes"
+                );
+                let entry = self.entry(&session, &transfer_id)?;
+                ensure!(
+                    !entry.download && !entry.ready,
+                    "native upload is not writable"
+                );
+                ensure!(
+                    offset == entry.written,
+                    "chunk offset {offset} differs from {}",
+                    entry.written
+                );
+                let next = offset + data.len() as u64;
+                ensure!(next <= entry.size, "chunk exceeds declared file size");
+                OpenOptions::new()
+                    .append(true)
+                    .open(&entry.path)?
+                    .write_all(&data)?;
+                entry.written = next;
+                Ok(json!({"next_offset":next,"eof":false}))
+            }
+            BrowserFileCommand::Finish { transfer_id } => {
+                let entry = self.entry(&session, &transfer_id)?;
+                ensure!(
+                    !entry.download && entry.written == entry.size,
+                    "upload incomplete: {} of {} bytes",
+                    entry.written,
+                    entry.size
+                );
+                entry.ready = true;
+                Ok(
+                    json!({"transfer_id":transfer_id,"byte_size":entry.size,"staged_path":entry.path}),
+                )
+            }
+            BrowserFileCommand::Import {
+                transfer_id,
+                browser_path,
+            } => {
+                let suffix = transfer_id
+                    .strip_prefix("tr_")
+                    .context("download transfer_id must start with tr_")?;
+                Uuid::parse_str(suffix).context("invalid download transfer_id")?;
+                ensure!(
+                    !self.entries.contains_key(&transfer_id),
+                    "native download transfer already exists"
+                );
+                let reported = PathBuf::from(browser_path);
+                ensure!(
+                    reported.is_absolute(),
+                    "download path must be absolute: {reported:?}"
+                );
+                ensure!(
+                    !fs::symlink_metadata(&reported)?.file_type().is_symlink(),
+                    "download file is a symbolic link"
+                );
+                let path = reported.canonicalize()?;
+                let directory = path.parent().context("download has no directory")?;
+                ensure!(
+                    directory.ends_with(Path::new("BrowserSkill").join(&transfer_id)),
+                    "download is outside its BrowserSkill transfer directory: {path:?}"
+                );
+                let metadata = fs::metadata(&path)?;
+                ensure!(
+                    metadata.is_file() && metadata.len() <= MAX_BYTES,
+                    "download must be a regular file within {MAX_BYTES} bytes"
+                );
+                let size = metadata.len();
+                let staging = self.root.path().join(&transfer_id);
+                fs::create_dir(&staging)?;
+                let destination = staging.join("payload");
+                self.entries.insert(
+                    transfer_id.clone(),
+                    Entry {
+                        session,
+                        path: destination.clone(),
+                        size,
+                        written: 0,
+                        ready: false,
+                        download: true,
+                    },
+                );
+                let mut target = OpenOptions::new()
+                    .write(true)
+                    .create_new(true)
+                    .open(&destination)?;
+                let copied = std::io::copy(&mut File::open(&path)?.take(size), &mut target)?;
+                ensure!(
+                    copied == size,
+                    "download changed during import: {copied} of {size} bytes"
+                );
+                fs::remove_file(&path)?;
+                fs::remove_dir(directory)?;
+                let entry = self
+                    .entries
+                    .get_mut(&transfer_id)
+                    .expect("inserted download");
+                entry.written = size;
+                entry.ready = true;
+                Ok(json!({"transfer_id":transfer_id,"byte_size":size}))
+            }
+            BrowserFileCommand::Read {
+                transfer_id,
+                offset,
+            } => {
+                let entry = self.entry(&session, &transfer_id)?;
+                ensure!(
+                    entry.download && entry.ready,
+                    "native download is not readable"
+                );
+                ensure!(offset <= entry.size, "read offset exceeds download size");
+                let count = (entry.size - offset).min(CHUNK_BYTES as u64) as usize;
+                let mut data = vec![0; count];
+                let mut file = File::open(&entry.path)?;
+                file.seek(SeekFrom::Start(offset))?;
+                file.read_exact(&mut data)?;
+                let next = offset + count as u64;
+                Ok(
+                    json!({"next_offset":next,"eof":next == entry.size,"data_base64":STANDARD.encode(data)}),
+                )
+            }
+            BrowserFileCommand::Release { transfer_id } => {
+                self.release(&session, &transfer_id)?;
+                Ok(json!({"released":true}))
+            }
+            BrowserFileCommand::Close => {
+                let ids: Vec<_> = self
+                    .entries
+                    .iter()
+                    .filter(|(_, e)| e.session == session)
+                    .map(|(id, _)| id.clone())
+                    .collect();
+                for id in &ids {
+                    self.release(&session, id)?;
+                }
+                Ok(json!({"released":ids.len()}))
+            }
+        }
+    }
+
+    fn release(&mut self, session: &str, id: &str) -> Result<()> {
+        let entry = self.entry(session, id)?;
+        let directory = entry.path.parent().context("transfer has no directory")?;
+        // Each directory contains one transfer. Retain the entry on a removal
+        // error so explicit session close can finish the same cleanup later.
+        if entry.path.exists() {
+            fs::remove_file(&entry.path)?;
+        }
+        fs::remove_dir(directory)?;
+        self.entries.remove(id);
+        Ok(())
+    }
+
+    pub fn close(&mut self) -> Result<()> {
+        let entries: Vec<_> = self
+            .entries
+            .iter()
+            .map(|(id, e)| (id.clone(), e.session.clone()))
+            .collect();
+        let mut errors = Vec::new();
+        for (id, session) in entries {
+            if let Err(error) = self.release(&session, &id) {
+                errors.push(format!("{id}: {error:#}"));
+            }
+        }
+        if !errors.is_empty() {
+            bail!("native file cleanup: {}", errors.join("; "));
+        }
+        Ok(())
+    }
+}
