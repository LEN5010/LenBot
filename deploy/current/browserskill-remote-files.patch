+//! Browser-machine file operations, carried only over the bound extension connection.
+
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct BrowserFileParams {
+    pub session_id: String,
+    pub command: BrowserFileCommand,
+}
+
+#[derive(Debug, Serialize, Deserialize, JsonSchema)]
+#[serde(tag = "action", rename_all = "snake_case", deny_unknown_fields)]
+pub enum BrowserFileCommand {
+    Ready,
+    Begin {
+        name: String,
+        byte_size: u64,
+    },
+    Chunk {
+        transfer_id: String,
+        offset: u64,
+        data_base64: String,
+    },
+    Finish {
+        transfer_id: String,
+    },
+    Import {
+        transfer_id: String,
+        browser_path: String,
+    },
+    Read {
+        transfer_id: String,
+        offset: u64,
+    },
+    Release {
+        transfer_id: String,
+    },
+    Close,
+}
