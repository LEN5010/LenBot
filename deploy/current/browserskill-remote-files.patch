index 0000000..3f5de81
--- /dev/null
+++ b/crates/bsk-cli/src/daemon/browser_files.rs
@@ -0,0 +1,188 @@
+//! File bytes between the daemon staging area and one session's browser helper.
+
+use std::fs::File;
+use std::io::Read;
+use std::sync::Arc;
+use std::time::Duration;
+
+use base64::{Engine, engine::general_purpose::STANDARD};
+use bsk_protocol::{BrowserFileCommand, BrowserFileParams, ErrorCode, Method, RpcError};
+use bsk_protocol::{
+    TransferBeginResult, TransferChunkParams, TransferChunkResult, TransferIdParams,
+    TransferReleaseResult, UploadParams,
+};
+use serde::{Deserialize, de::DeserializeOwned};
+
+use super::{
+    file_transfer::TRANSFER_CHUNK_SIZE, inflight::ToolInflightEntry, sessions::SessionId,
+    state::DaemonState,
+};
+
+#[derive(Deserialize)]
+struct NativeReady {
+    staged_path: String,
+}
+
+async fn call<T: DeserializeOwned>(
+    state: &Arc<DaemonState>,
+    sid: &SessionId,
+    command: BrowserFileCommand,
+    timeout: Duration,
+    inflight: &Arc<ToolInflightEntry>,
+) -> Result<T, RpcError> {
+    let params = BrowserFileParams {
+        session_id: sid.0.clone(),
+        command,
+    };
+    let result = state
+        .tool_queues
+        .dispatch(
+            sid,
+            Method::ToolFileTransfer,
+            serde_json::to_value(params).map_err(protocol)?,
+            timeout,
+            Some(inflight.clone()),
+        )
+        .await
+        .map_err(|error| error.into_rpc())?;
+    serde_json::from_value(result).map_err(protocol)
+}
+
+pub async fn upload(
+    state: &Arc<DaemonState>,
+    sid: &SessionId,
+    upload: &mut UploadParams,
+    timeout: Duration,
+    inflight: &Arc<ToolInflightEntry>,
+) -> Result<(), RpcError> {
+    for file in &mut upload.files {
+        let path = file
+            .staged_path
+            .as_ref()
+            .expect("resolved daemon upload path");
+        let mut source = File::open(path).map_err(protocol)?;
+        let size = source.metadata().map_err(protocol)?.len();
+        let begin: TransferBeginResult = call(
+            state,
+            sid,
+            BrowserFileCommand::Begin {
+                name: file.name.clone(),
+                byte_size: size,
+            },
+            timeout,
+            inflight,
+        )
+        .await?;
+        if begin.chunk_size != TRANSFER_CHUNK_SIZE {
+            return Err(protocol(format!(
+                "native chunk size differs: {}",
+                begin.chunk_size
+            )));
+        }
+        let mut offset = 0;
+        let mut data = vec![0; TRANSFER_CHUNK_SIZE as usize];
+        while offset < size {
+            let count = (size - offset).min(data.len() as u64) as usize;
+            source.read_exact(&mut data[..count]).map_err(protocol)?;
+            let chunk: TransferChunkResult = call(
+                state,
+                sid,
+                BrowserFileCommand::Chunk {
+                    transfer_id: begin.transfer_id.clone(),
+                    offset,
+                    data_base64: STANDARD.encode(&data[..count]),
+                },
+                timeout,
+                inflight,
+            )
+            .await?;
+            offset += count as u64;
+            if chunk.next_offset != offset {
+                return Err(protocol(format!(
+                    "native upload offset differs: {} != {offset}",
+                    chunk.next_offset
+                )));
+            }
+        }
+        let ready: NativeReady = call(
+            state,
+            sid,
+            BrowserFileCommand::Finish {
+                transfer_id: begin.transfer_id,
+            },
+            timeout,
+            inflight,
+        )
+        .await?;
+        file.staged_path = Some(ready.staged_path);
+    }
+    Ok(())
+}
+
+pub async fn download(
+    state: &Arc<DaemonState>,
+    sid: &SessionId,
+    id: &str,
+    size: u64,
+    timeout: Duration,
+    inflight: &Arc<ToolInflightEntry>,
+) -> Result<u64, RpcError> {
+    state.transfers.prepare_remote_download(id, size)?;
+    let mut offset = 0;
+    loop {
+        let chunk: TransferChunkResult = call(
+            state,
+            sid,
+            BrowserFileCommand::Read {
+                transfer_id: id.to_string(),
+                offset,
+            },
+            timeout,
+            inflight,
+        )
+        .await?;
+        let data_base64 = chunk
+            .data_base64
+            .ok_or_else(|| protocol("native download returned no bytes"))?;
+        let received = state.transfers.write_download_chunk(TransferChunkParams {
+            transfer_id: id.to_string(),
+            offset,
+            data_base64,
+        })?;
+        if received.next_offset != chunk.next_offset
+            || chunk.eof != (chunk.next_offset == size)
+            || (!chunk.eof && chunk.next_offset == offset)
+        {
+            return Err(protocol(format!(
+                "native download boundary differs: offset={offset}, next={}, eof={}, size={size}",
+                chunk.next_offset, chunk.eof
+            )));
+        }
+        offset = chunk.next_offset;
+        if chunk.eof {
+            break;
+        }
+    }
+    state.transfers.finish_download(TransferIdParams {
+        transfer_id: id.to_string(),
+    })?;
+    let _: TransferReleaseResult = call(
+        state,
+        sid,
+        BrowserFileCommand::Release {
+            transfer_id: id.to_string(),
+        },
+        timeout,
+        inflight,
+    )
+    .await?;
+    Ok(offset)
+}
+
+fn protocol(error: impl std::fmt::Display) -> RpcError {
+    RpcError {
+        code: ErrorCode::ProtocolError,
+        message: error.to_string(),
+        data: None,
+    }
+}
