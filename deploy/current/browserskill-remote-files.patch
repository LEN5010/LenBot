diff --git a/apps/extension/src/tools/native-files.ts b/apps/extension/src/tools/native-files.ts
new file mode 100644
index 0000000..b7eadac
--- /dev/null
+++ b/apps/extension/src/tools/native-files.ts
@@ -0,0 +1,96 @@
+import type { RpcError } from "@/transport/types";
+
+export type BrowserFileCommand =
+  | { action: "ready" }
+  | { action: "begin"; name: string; byte_size: number }
+  | { action: "chunk"; transfer_id: string; offset: number; data_base64: string }
+  | { action: "finish" | "release"; transfer_id: string }
+  | { action: "import"; transfer_id: string; browser_path: string }
+  | { action: "read"; transfer_id: string; offset: number }
+  | { action: "close" };
+export interface BrowserFileParams {
+  session_id: string;
+  command: BrowserFileCommand;
+}
+interface Reply {
+  id: string;
+  result?: unknown;
+  error?: RpcError;
+}
+
+/** One Native Messaging port; its files belong to the existing browser sessions. */
+class NativeFiles {
+  private port: chrome.runtime.Port | null = null;
+  private readonly sessions = new Set<string>();
+  private readonly pending = new Map<
+    string,
+    { resolve(value: unknown): void; reject(error: Error): void }
+  >();
+
+  private connect(): chrome.runtime.Port {
+    if (this.port) return this.port;
+    const port = chrome.runtime.connectNative("com.browserskill.files");
+    port.onMessage.addListener((message: Reply) => {
+      if (
+        !message ||
+        typeof message.id !== "string" ||
+        "result" in message === "error" in message
+      ) {
+        const error = new Error(
+          `Invalid native file response: ${JSON.stringify(message).slice(0, 300)}`,
+        );
+        for (const pending of this.pending.values()) pending.reject(error);
+        this.pending.clear();
+        port.disconnect();
+        this.port = null;
+        return;
+      }
+      const pending = this.pending.get(message.id);
+      if (!pending) return; // A cancelled call can complete its current file chunk.
+      this.pending.delete(message.id);
+      if (message.error) pending.reject(new Error(message.error.message));
+      else pending.resolve(message.result);
+    });
+    port.onDisconnect.addListener(() => {
+      const error = new Error(
+        chrome.runtime.lastError?.message ?? "Native file helper disconnected",
+      );
+      this.port = null;
+      for (const pending of this.pending.values()) pending.reject(error);
+      this.pending.clear();
+    });
+    this.port = port;
+    return port;
+  }
+
+  async call<T>(params: BrowserFileParams, signal?: AbortSignal): Promise<T> {
+    signal?.throwIfAborted();
+    const port = this.connect();
+    const id = crypto.randomUUID();
+    if (["begin", "import"].includes(params.command.action)) this.sessions.add(params.session_id);
+    let onAbort: () => void;
+    const result = new Promise<unknown>((resolve, reject) => {
+      onAbort = () => {
+        this.pending.delete(id);
+        reject(signal!.reason);
+      };
+      this.pending.set(id, { resolve, reject });
+      signal?.addEventListener("abort", onAbort, { once: true });
+      port.postMessage({ id, params });
+    });
+    try {
+      return (await result) as T;
+    } finally {
+      signal?.removeEventListener("abort", onAbort!);
+      this.pending.delete(id);
+    }
+  }
+
+  async releaseSession(session: string): Promise<void> {
+    if (!this.sessions.has(session)) return;
+    await this.call({ session_id: session, command: { action: "close" } });
+    this.sessions.delete(session);
+  }
+}
+
+export const nativeFiles = new NativeFiles();
