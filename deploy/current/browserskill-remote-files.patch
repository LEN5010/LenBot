@@ -0,0 +1,81 @@
+use anyhow::{Context, Result, ensure};
+use clap::Parser;
+use serde_json::json;
+use std::path::PathBuf;
+
+pub const HOST: &str = "com.browserskill.files";
+
+#[derive(Parser)]
+struct Install {
+    #[arg(long)]
+    extension_id: String,
+    /// User-level NativeMessagingHosts directory; defaults to Google Chrome.
+    #[arg(long)]
+    manifest_directory: Option<PathBuf>,
+}
+
+pub fn run() -> Result<()> {
+    let args = Install::parse_from(
+        std::iter::once("bsk-file-host install".to_string()).chain(std::env::args().skip(2)),
+    );
+    ensure!(
+        args.extension_id.len() == 32
+            && args
+                .extension_id
+                .bytes()
+                .all(|c| (b'a'..=b'p').contains(&c)),
+        "extension-id must be the 32-character Chrome extension ID"
+    );
+    let directory = match args.manifest_directory {
+        Some(path) => path,
+        None => default_directory()?,
+    };
+    std::fs::create_dir_all(&directory)?;
+    let manifest = directory.canonicalize()?.join(format!("{HOST}.json"));
+    let binary = std::env::current_exe()?.canonicalize()?;
+    std::fs::write(
+        &manifest,
+        serde_json::to_vec_pretty(&json!({
+            "name":HOST, "description":"BrowserSkill session files", "path":binary,
+            "type":"stdio", "allowed_origins":[format!("chrome-extension://{}/", args.extension_id)]
+        }))?,
+    )?;
+    #[cfg(windows)]
+    {
+        let status = std::process::Command::new("reg")
+            .args([
+                "ADD",
+                &format!("HKCU\\Software\\Google\\Chrome\\NativeMessagingHosts\\{HOST}"),
+                "/ve",
+                "/t",
+                "REG_SZ",
+                "/d",
+            ])
+            .arg(&manifest)
+            .arg("/f")
+            .status()?;
+        ensure!(
+            status.success(),
+            "Native Messaging registry update failed: {status}"
+        );
+    }
+    println!(
+        "{}",
+        json!({"manifest":manifest,"binary":binary,"extension_id":args.extension_id})
+    );
+    Ok(())
+}
+
+fn default_directory() -> Result<PathBuf> {
+    let home = dirs::home_dir().context("user home directory is unavailable")?;
+    #[cfg(target_os = "macos")]
+    return Ok(home.join("Library/Application Support/Google/Chrome/NativeMessagingHosts"));
+    #[cfg(target_os = "linux")]
+    return Ok(home.join(".config/google-chrome/NativeMessagingHosts"));
+    #[cfg(windows)]
+    return Ok(dirs::data_local_dir()
+        .context("local application directory is unavailable")?
+        .join("BrowserSkill/native-files"));
+    #[cfg(not(any(target_os = "macos", target_os = "linux", windows)))]
+    anyhow::bail!("choose --manifest-directory for this platform; home={home:?}");
+}
