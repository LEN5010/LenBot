# syntax=docker/dockerfile:1.9
# Build from a git archive of OpenViking a09a9d20a8e07d08973aee177802d00e08df29e6.
# A separate service image keeps its incompatible SDK dependencies out of LenBot.
# The HTTP service needs the native filesystem and vector engine, not VikingBot,
# its standalone Rust CLI or a second management frontend.
FROM rust:1.91.1-trixie AS rust-toolchain

FROM ghcr.io/astral-sh/uv:python3.13-trixie-slim AS builder
COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup
ENV PATH="/usr/local/cargo/bin:${PATH}"
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git pkg-config \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_OPENVIKING=0.0.0+a09a9d2
ENV OV_SKIP_OV_BUILD=1 OV_SKIP_STUDIO_BUILD=1 OV_REQUIRE_RAGFS_BUILD=1
ENV UV_LINK_MODE=copy CARGO_TARGET_DIR=/cargo-target
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/cargo-target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    uv sync --locked --no-dev --no-editable

FROM python:3.13-slim-trixie
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libstdc++6 git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/LICENSE /usr/share/openviking/LICENSE
ENV PATH="/app/.venv/bin:${PATH}" HOME=/service
WORKDIR /service
LABEL org.opencontainers.image.source="https://github.com/volcengine/OpenViking"
LABEL org.opencontainers.image.revision="a09a9d20a8e07d08973aee177802d00e08df29e6"
EXPOSE 1933
ENTRYPOINT ["openviking-server", "--config", "/service/ov.conf"]
