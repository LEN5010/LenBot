      "expect": [
        "观察第二轮是否承接第一轮实际保存的说法；不预设第一轮说了某个具体答案。",
        "如先前说法不确定或有误，应说明已知事实与未确认处；由人工根据实际输出评分。"
      ],
      "steps": [
        {
          "type": "message",
          "event": {
            "post_type": "message",
            "message_type": "group",
            "self_id": "90001",
            "group_id": "80001",
            "user_id": "70001",
            "message_id": "synthetic-1001",
            "time": 1790000000,
            "sender": {"nickname": "合成甲", "card": "", "role": "member"},
            "message": [
              {"type": "at", "data": {"qq": "90001"}},
              {"type": "text", "data": {"text": "我上周推荐的是哪本书？"}}
